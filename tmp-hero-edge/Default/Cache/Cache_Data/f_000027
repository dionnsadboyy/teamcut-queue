:root {
  color-scheme: light;
  --color-black: #111111;
  --color-white: #ffffff;
  --color-gray-100: #f3f3f1;
  --color-gray-300: #d1d1ce;
  --color-gray-600: #686865;
  --color-accent: #ed1235;
  --color-open: #34b66a;
  --font-body: Arial, Helvetica, sans-serif;
  --content-width: 1120px;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}
html {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0;
  overflow-x: hidden;
  scroll-behavior: smooth;
}
body {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0;
  overflow-x: hidden;
  background: var(--color-white);
  color: var(--color-black);
  font-family: var(--font-body);
  line-height: 1.6;
}
main {
  display: block;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0;
}
a {
  color: inherit;
}
.site-header,
.site-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 1.25rem 1.5rem;
}
.site-header {
  position: absolute;
  z-index: 10;
  top: 0;
  left: 0;
  width: 100%;
  padding: 0.5rem 1.5rem;
  border: 0;
  background: transparent;
  color: var(--color-white);
}
.wordmark {
  font-size: 1.25rem;
  font-weight: 900;
  letter-spacing: -0.06em;
  text-decoration: none;
}
.wordmark span {
  color: var(--color-accent);
}
.site-header .wordmark {
  display: block;
  width: 4.5rem;
  height: 4.5rem;
  flex: 0 0 auto;
  overflow: hidden;
}
.site-header .teamcut-wordmark {
  display: block;
  width: 100%;
  height: 100%;
  overflow: visible;
}
.menu-toggle {
  position: relative;
  z-index: 6;
  display: grid;
  min-width: 2.75rem;
  min-height: 2.75rem;
  align-content: center;
  gap: 0.3rem;
  padding: 0.5rem 0.15rem;
  border: 0;
  background: rgb(0 0 0 / 28%);
  cursor: pointer;
}
.menu-toggle span {
  display: block;
  justify-self: center;
  width: 1.5rem;
  height: 1.5px;
  background: var(--color-white);
  transition:
    transform 0.2s ease,
    opacity 0.2s ease;
}
.menu-toggle:focus-visible {
  outline: 1px solid var(--color-white);
  outline-offset: 3px;
}
.menu-toggle[aria-expanded="true"] span:first-child {
  transform: translateY(6px) rotate(45deg);
}
.menu-toggle[aria-expanded="true"] span:nth-child(2) {
  opacity: 0;
}
.menu-toggle[aria-expanded="true"] span:last-child {
  transform: translateY(-6px) rotate(-45deg);
}
.site-nav {
  position: absolute;
  z-index: 5;
  top: calc(100% + 0.4rem);
  right: 1.5rem;
  display: grid;
  width: min(19rem, calc(100% - 3rem));
  padding: 0.4rem 1rem;
  border: 1px solid #414141;
  background: #090909;
}
.site-nav[hidden] {
  display: none;
}
.site-nav a {
  padding: 0.9rem 0;
  border-bottom: 1px solid #343434;
  color: var(--color-white);
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-decoration: none;
}
.site-nav a:last-child {
  border-bottom: 0;
}
.site-nav a:hover,
.site-nav a:focus-visible {
  color: #c4c4c4;
}
.section {
  padding: 4rem 1.5rem;
}
.hero {
  --hero-stage-shift: 2.75rem;
  position: relative;
  display: flex;
  width: 100%;
  max-width: none;
  min-height: calc(max(100svh, 48rem) + var(--hero-stage-shift));
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
  margin: 0;
  padding: 0 1.5rem 2rem;
  background: var(--color-black);
  color: var(--color-white);
}
main > section {
  width: 100%;
  max-width: 100%;
  min-width: 0;
}
img,
svg,
video,
canvas {
  max-width: 100%;
}
.hero-image {
  position: absolute;
  z-index: 0;
  top: 0;
  right: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: 50% 48%;
}
.hero-foreground {
  position: absolute;
  z-index: 3;
  top: 0;
  right: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: 50% 48%;
  pointer-events: none;
}
.hero-content {
  position: relative;
  padding-top: clamp(6.5rem, 14vh, 10rem);
}
.hero h1 {
  position: relative;
  z-index: 2;
  width: 100%;
  margin: 0;
  text-align: center;
  transform: translateY(-1.5rem);
  font-size: clamp(4.4rem, 20.5vw, 11rem);
  font-family: Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
  font-weight: 900;
  line-height: 0.77;
  letter-spacing: 0.035em;
  white-space: nowrap;
}
.hero h1 span {
  color: var(--color-accent);
}
.hero-tagline {
  position: relative;
  z-index: 4;
  margin: 1.25rem 0 0 0.1rem;
  color: rgb(255 255 255 / 78%);
  font-size: 0.72rem;
  letter-spacing: 0.19em;
  line-height: 1.9;
}
.hero-signature {
  position: relative;
  z-index: 4;
  display: block;
  width: 2.5rem;
  height: 1px;
  margin: 0.9rem 0 0 0.1rem;
  background: rgb(255 255 255 / 75%);
}
.hero-bottom {
  position: relative;
  z-index: 5;
}
.queue-strip {
  display: block;
  width: 100%;
  min-width: 0;
  padding: 0;
}
.hero-branch-tabs {
  display: flex;
  width: 100%;
  min-width: 0;
  gap: 0.35rem;
  overflow-x: auto;
  overscroll-behavior-inline: contain;
  border-bottom: 1px solid rgb(255 255 255 / 35%);
  scrollbar-width: none;
}
.hero-branch-tabs::-webkit-scrollbar {
  display: none;
}
.hero-branch-tab {
  flex: 0 0 auto;
  min-width: 0;
  padding: 0.45rem 0.45rem 0.62rem;
  border: 0;
  border-bottom: 2px solid transparent;
  margin-bottom: -1px;
  background: transparent;
  color: rgb(255 255 255 / 68%);
  font: inherit;
  font-size: 0.56rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-align: center;
  white-space: nowrap;
  cursor: pointer;
}
.hero-branch-tab[aria-selected="true"] {
  border-bottom-color: var(--color-accent);
  color: var(--color-white);
}
.hero-branch-data {
  display: grid;
  width: 100%;
  min-width: 0;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
  align-items: center;
  gap: 0.5rem 0.8rem;
  padding-top: 0.75rem;
}
.branch-status {
  min-width: 0;
  padding-right: 0.3rem;
}
.branch-status p {
  display: flex;
  align-items: center;
  gap: 0.55rem;
  margin: 0.2rem 0;
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.12em;
}
.location-mark {
  display: inline-flex;
  flex: 0 0 1rem;
  align-items: center;
  color: var(--color-white);
}
.location-mark svg {
  display: block;
  width: 1rem;
  height: 1rem;
  fill: none;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 1.8;
}
.status-mark {
  width: 0.55rem;
  height: 0.55rem;
  border-radius: 50%;
  background: var(--color-open);
}
.hero .status-mark {
  display: inline-flex;
  flex: 0 0 1rem;
  align-items: center;
  justify-content: center;
  width: 1rem;
  height: 1rem;
  border-radius: 0;
  background: transparent;
  color: var(--color-white);
}
.hero .status-mark.hero-status-dot {
  flex: 0 0 0.52rem;
  width: 0.52rem;
  height: 0.52rem;
  border-radius: 50%;
  background: var(--color-open);
}
.hero .open-status.is-unavailable .hero-status-dot {
  background: #777;
}
.hero .open-status.is-unavailable {
  color: #a5a5a5;
}
.hero .status-mark svg {
  display: block;
  width: 1rem;
  height: 1rem;
  fill: none;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 1.8;
}
.queue-count {
  display: flex;
  align-items: center;
  gap: 0.55rem;
  min-width: 0;
  padding-left: 0.75rem;
  border-left: 1px solid rgb(255 255 255 / 55%);
}
.queue-count strong {
  font-size: clamp(2.7rem, 13vw, 4.5rem);
  line-height: 0.9;
  letter-spacing: -0.06em;
}
.queue-count span {
  color: rgb(255 255 255 / 78%);
  font-size: 0.59rem;
  letter-spacing: 0.12em;
  line-height: 1.8;
}
.branch-link {
  grid-column: 1 / -1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 0.15rem;
  padding: 0.5rem 0 0;
  border-top: 1px solid rgb(255 255 255 / 28%);
  color: var(--color-white);
  font-size: 0.64rem;
  letter-spacing: 0.15em;
  text-decoration: none;
}
.branch-link span {
  font-size: 1.2rem;
}
.hero-branch-data .branch-link {
  margin-top: 0.1rem;
  padding-top: 0.5rem;
  border-top: 1px solid rgb(255 255 255 / 28%);
}
.hero-branch-data .branch-link > span:first-child {
  font-size: 0.64rem;
}
.scroll-cue {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  margin: 1.1rem 0 0 0.1rem;
  color: var(--color-white);
  font-size: 0.62rem;
  letter-spacing: 0.2em;
  text-decoration: none;
}
.scroll-cue span:last-child {
  font-size: 0.95rem;
  line-height: 1;
}
.site-footer {
  flex-wrap: wrap;
  border-top: 1px solid var(--color-gray-300);
  color: var(--color-gray-600);
  font-size: 0.875rem;
}
.site-footer p {
  margin: 0;
}
.site-footer small {
  width: 100%;
}
:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 4px;
}

@media (min-width: 600px) {
  .site-header {
    padding: 0.5rem 4vw;
  }
  .site-nav {
    right: 4vw;
  }
  .hero {
    min-height: calc(100svh + var(--hero-stage-shift));
    padding: 0 4vw 2rem;
  }
  .hero-content {
    padding-top: clamp(8.5rem, 14vh, 10.5rem);
  }
  .hero h1 {
    font-size: clamp(8rem, 18.5vw, 17rem);
  }
  .hero-tagline {
    margin-top: 1.6rem;
  }
  .hero-branch-tabs {
    max-width: 42rem;
    gap: 0.8rem;
  }
  .hero-branch-tab {
    padding-inline: 0.65rem;
    font-size: 0.62rem;
  }
  .hero-branch-data {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 1rem;
    padding-top: 0.9rem;
  }
  .branch-status {
    padding-right: 1rem;
  }
  .queue-count {
    padding-left: 1.4rem;
  }
  .branch-link {
    grid-column: 1 / -1;
    justify-content: space-between;
    margin-top: 0;
    padding: 0.55rem 0 0;
    border-top: 1px solid rgb(255 255 255 / 28%);
    border-left: 0;
  }
  .queue-count strong {
    font-size: clamp(3.5rem, 6vw, 5rem);
  }
  .queue-count span {
    font-size: 0.7rem;
  }
  .scroll-cue {
    margin-top: 1.5rem;
  }
}

@media (min-width: 800px) {
  .hero-branch-data {
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 1rem;
  }
  .hero-branch-data .branch-link {
    grid-column: auto;
    justify-content: center;
    gap: 1rem;
    padding: 0 0 0 1.4rem;
    border-top: 0;
    border-left: 1px solid rgb(255 255 255 / 55%);
  }
}

@media (min-width: 960px) {
  .site-header {
    padding-inline: 5vw;
  }
  .site-nav {
    right: 5vw;
  }
  .hero {
    padding-inline: 5vw;
  }
  .hero-image,
  .hero-foreground {
    object-position: 50% 43%;
  }
  .hero h1 {
    font-size: min(18vw, 18rem);
  }
}

@media (max-width: 759px) {
  html,
  body {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  html::-webkit-scrollbar,
  body::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }
  .site-header {
    align-items: flex-start;
    padding-top: 0.25rem;
  }
  .site-header .wordmark {
    position: relative;
    z-index: 6;
  }
  .site-header .teamcut-wordmark {
    height: 2.625rem;
  }
  .menu-toggle {
    z-index: 7;
    background: transparent;
  }
  .site-nav {
    position: fixed;
    z-index: 5;
    inset: 0;
    display: flex;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    flex-direction: column;
    justify-content: center;
    padding: 7rem max(1.5rem, 8vw) 3rem;
    border: 0;
    background: rgb(7 7 7 / 91%);
  }
  .site-nav a {
    display: block;
    padding: 1rem 0;
    border-bottom: 1px solid rgb(255 255 255 / 24%);
    font-family: Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
    font-size: clamp(1.5rem, 7vw, 2.25rem);
    font-weight: 400;
    letter-spacing: 0.015em;
    line-height: 1.05;
    overflow-wrap: anywhere;
  }
  .site-nav a:last-child {
    border-bottom: 0;
  }
  .site-nav a:hover,
  .site-nav a:focus-visible {
    color: var(--color-accent);
  }
}

/* Styling section lain tetap menggunakan fondasi sebelumnya. */
.section-heading {
  margin-bottom: 2rem;
}
.section-heading h2,
.booking h2 {
  margin: 0.35rem 0 0;
  font-size: clamp(2rem, 8vw, 3.25rem);
  line-height: 1.05;
  letter-spacing: -0.04em;
}
.branch-list {
  border-top: 1px solid var(--color-gray-300);
}
.branch-item {
  padding: 1.25rem 0;
  border-bottom: 1px solid var(--color-gray-300);
}
.branch-item h3,
.service-item h3 {
  margin: 0;
  font-size: 1.25rem;
}
.branch-item p {
  margin: 0.25rem 0;
  color: var(--color-gray-600);
}
.branch-item .queue {
  color: var(--color-black);
  font-size: 0.875rem;
}
.supporting-note {
  color: var(--color-gray-600);
  font-size: 0.875rem;
}
.services {
  max-width: none;
  margin: 0;
  padding: 4.5rem 1.25rem 5rem;
  background: #090909;
  color: var(--color-white);
}
.services-inner {
  width: 100%;
  max-width: var(--content-width);
  margin-inline: auto;
}
.services-heading {
  margin-bottom: 2rem;
}
.services-kicker {
  margin: 0 0 0.15rem;
  color: #b8b8b8;
  font-size: 0.8rem;
  letter-spacing: 0.34em;
}
.services-title {
  margin: 0;
  color: var(--color-white);
  font-family: Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
  font-size: clamp(4rem, 16vw, 10rem);
  font-weight: 400;
  line-height: 0.83;
  letter-spacing: -0.045em;
  white-space: nowrap;
}
.services-title span {
  color: var(--color-accent);
}
.services-intro {
  margin: 1rem 0 0;
  color: #c4c4c4;
  font-size: 0.7rem;
  letter-spacing: 0.22em;
  line-height: 1.9;
}
.services-rule {
  display: block;
  width: 2.5rem;
  height: 2px;
  margin-top: 0.9rem;
  background: var(--color-white);
}
.service-list {
  margin: 2rem 0 0;
  padding: 0;
  border-top: 1px solid #555;
  list-style: none;
}
.services .service-item {
  display: grid;
  grid-template-columns: 2rem minmax(0, 1fr) 6rem;
  align-items: start;
  column-gap: 0.65rem;
  padding: 1rem 0 1.1rem;
  border-bottom: 1px solid #484848;
}
.service-number {
  min-height: 100%;
  padding: 0.12rem 0.45rem 0 0;
  border-right: 1px solid #777;
  color: #c4c4c4;
  font-size: 0.75rem;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.08em;
}
.service-copy {
  min-width: 0;
}
.services .service-copy h3 {
  margin: 0;
  font-family: Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
  font-size: clamp(1.65rem, 7vw, 2.8rem);
  font-weight: 400;
  line-height: 1;
  letter-spacing: -0.025em;
  overflow-wrap: anywhere;
}
.service-copy p {
  max-width: 25ch;
  margin: 0.35rem 0 0;
  color: #c4c4c4;
  font-size: 0.76rem;
  line-height: 1.5;
}
.service-price {
  padding-top: 0.15rem;
  font-variant-numeric: tabular-nums;
}
.service-price-label {
  display: block;
  color: #c4c4c4;
  font-size: 0.47rem;
  letter-spacing: 0.1em;
  line-height: 1.4;
}
.service-price strong {
  display: block;
  margin-top: 0.25rem;
  color: var(--color-white);
  font-family: Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
  font-size: 1.12rem;
  font-weight: 400;
  line-height: 1.05;
  white-space: nowrap;
}
.service-price.is-unavailable strong {
  color: #a5a5a5;
}
.service-arrow {
  display: none;
}
.whatsapp-cta {
  max-width: none;
  margin: 0;
  padding: clamp(5.5rem, 13vw, 9rem) 1.25rem clamp(5rem, 10vw, 7rem);
  border-top: 1px solid #414141;
  background: #090909;
  color: var(--color-white);
}
.whatsapp-cta-inner {
  width: 100%;
  max-width: var(--content-width);
  margin-inline: auto;
}
.whatsapp-cta-title {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin: 0;
}
.whatsapp-cta-lead {
  font-size: clamp(2.25rem, 8vw, 5.25rem);
  font-weight: 300;
  line-height: 1;
  letter-spacing: -0.065em;
}
.whatsapp-cta-main {
  max-width: 100%;
  font-family: Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
  font-size: clamp(2.5rem, 13.3vw, 8.5rem);
  font-weight: 400;
  line-height: 0.92;
  letter-spacing: -0.045em;
  white-space: nowrap;
}
.whatsapp-cta-support {
  margin: 0.8rem 0 0;
  color: #c4c4c4;
  font-size: clamp(0.85rem, 3vw, 1.2rem);
  letter-spacing: 0.18em;
}
.whatsapp-cta-rule {
  display: block;
  width: 3.5rem;
  height: 2px;
  margin-top: 1.4rem;
  background: var(--color-white);
}
.whatsapp-cta-copy {
  max-width: 24rem;
  margin: 1.5rem 0 2rem;
  color: #b8b8b8;
  font-size: 0.95rem;
  line-height: 1.7;
}
.whatsapp-cta-link {
  display: flex;
  width: 100%;
  max-width: 34rem;
  min-height: 4.5rem;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.9rem 1.25rem;
  border: 1px solid #d7d7d7;
  border-radius: 999px;
  color: var(--color-white);
  font-family: Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
  font-size: 1.25rem;
  letter-spacing: 0.025em;
  text-decoration: none;
  transition:
    color 0.2s ease,
    background-color 0.2s ease;
}
.whatsapp-cta-link:hover,
.whatsapp-cta-link:focus-visible {
  background: var(--color-white);
  color: var(--color-black);
}
.whatsapp-cta-arrow {
  font-family: var(--font-body);
  font-size: 1.8rem;
  font-weight: 300;
  line-height: 1;
}

@media (min-width: 720px) {
  .branch-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: 2rem;
  }
  .branch-item {
    align-self: start;
  }
  .services {
    padding: 6rem 4vw 6.5rem;
  }
  .services-heading {
    margin-bottom: 2.5rem;
  }
  .services-kicker {
    font-size: 1rem;
  }
  .services-intro {
    margin-top: 1.2rem;
    font-size: 0.82rem;
  }
  .service-list {
    margin-top: 2.5rem;
  }
  .services .service-item {
    grid-template-columns: 3rem minmax(0, 1fr) 11rem 2.5rem;
    align-items: center;
    column-gap: 1.25rem;
    padding: 1.45rem 0.25rem;
  }
  .service-number {
    min-height: 3.4rem;
    padding-top: 0.3rem;
    font-size: 1rem;
  }
  .services .service-copy h3 {
    font-size: clamp(2.3rem, 5vw, 3.5rem);
  }
  .service-copy p {
    margin-top: 0.45rem;
