  color: var(--color-white);
  text-align: left;
  cursor: pointer;
  scroll-snap-align: start;
}
.hairstylist-card-photo {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  background: #1b1b1b;
  color: #777;
}
.hairstylist-card-photo img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.hairstylist-card-photo > span {
  font-size: 0.52rem;
  letter-spacing: 0.15em;
}
.hairstylist-avatar {
  display: grid;
  width: 100%;
  height: 100%;
  place-items: center;
  background: #202020;
  color: #969696;
  font-family: Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
  font-size: clamp(3rem, 16vw, 6rem);
  letter-spacing: -0.06em;
  line-height: 1;
}
.hairstylist-card-photo .hairstylist-avatar {
  font-size: clamp(3rem, 16vw, 6rem);
}
.hairstylist-avatar.is-generic svg {
  display: block;
  width: 34%;
  height: auto;
  fill: currentColor;
}
.hairstylist-detail-photo .hairstylist-avatar {
  position: absolute;
  inset: 0;
  font-size: clamp(5rem, 24vw, 9rem);
}
.hairstylist-card.is-placeholder {
  border-color: #292929;
  color: #8a8a8a;
  cursor: default;
}
.hairstylist-card.is-placeholder .hairstylist-card-photo {
  background: #141414;
}
.hairstylist-card.is-placeholder .hairstylist-card-caption {
  background: rgb(0 0 0 / 72%);
}
.hairstylist-card.is-placeholder .hairstylist-card-caption strong {
  font-size: 0.76rem;
  letter-spacing: 0.04em;
}
.hairstylist-card.is-placeholder .hairstylist-card-caption small {
  color: #888;
  font-size: 0.48rem;
}
.hairstylist-card-caption {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: end;
  gap: 0.1rem 0.4rem;
  padding: 0.65rem;
  background: rgb(0 0 0 / 82%);
}
.hairstylist-card-caption strong {
  font-size: 1rem;
  line-height: 1;
}
.hairstylist-card-caption small {
  color: #d0d0d0;
  font-size: 0.56rem;
  letter-spacing: 0.1em;
}
.hairstylist-card-caption i {
  grid-column: 2;
  grid-row: 1 / 3;
  color: var(--color-white);
  font-size: 1.15rem;
  font-style: normal;
}
.hairstylist-card:hover .hairstylist-card-caption strong,
.hairstylist-card:focus-visible .hairstylist-card-caption strong {
  color: #d0d0d0;
}
.branch-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-top: 1.2rem;
}
.branch-controls > button {
  padding: 0.3rem 0;
  border: 0;
  background: transparent;
  color: var(--color-white);
  font-size: 1.6rem;
  cursor: pointer;
}
.branch-controls > button:disabled {
  color: #626262;
  cursor: default;
}
.branch-controls .branch-pagination {
  gap: 0.55rem;
}
.branch-controls .branch-marker {
  width: 2rem;
  height: 3px;
  background: #484848;
}
.branch-controls .branch-marker[aria-current="true"] {
  width: 3rem;
  background: var(--color-white);
}

@media (min-width: 760px) {
  .branches {
    padding: 5rem 3rem 4.5rem;
  }
  .branches-heading {
    grid-template-columns: minmax(0, 1fr) auto;
    margin-bottom: 2.25rem;
  }
  .branches-heading h2 {
    font-size: clamp(4rem, 9vw, 7.5rem);
  }
  .branch-lead {
    margin-top: 1.5rem;
    font-size: 0.78rem;
  }
  .branch-side-index {
    margin-top: 6rem;
  }
  .branch-slide {
    flex-basis: calc(100% - 3rem);
    gap: 2rem;
  }
  .branch-panel {
    gap: 1.4rem;
    padding: 0.75rem;
  }
  .branch-panel .hairstylist-area {
    padding-inline: 0.35rem;
  }
  .branch-photo-card {
    aspect-ratio: 1.38 / 1;
    min-height: 28rem;
  }
  .branch-card-info {
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.55rem 1rem;
    padding: 1.2rem 1.5rem;
  }
  .branch-card-name h3 {
    font-size: clamp(2.5rem, 5vw, 4.4rem);
  }
  .branch-open-status {
    font-size: 0.72rem;
  }
  .branch-queue {
    gap: 0.7rem;
    padding-inline: 1.2rem;
  }
  .branch-queue strong {
    font-size: clamp(3.25rem, 6vw, 5rem);
  }
  .branch-queue span {
    font-size: 0.65rem;
  }
  .branch-map-link {
    min-height: 2.25rem;
    font-size: 0.7rem;
  }
  .branch-map-link i {
    font-size: 1.45rem;
  }
  .hairstylist-area {
    margin-top: 0.25rem;
  }
  .hairstylist-heading {
    margin-bottom: 0.9rem;
  }
  .hairstylist-heading h4 {
    font-size: 0.9rem;
  }
  .hairstylist-view-all {
    font-size: 0.68rem;
  }
  .hairstylist-gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    overflow: visible;
  }
  .hairstylist-card {
    width: 100%;
    aspect-ratio: 1 / 1.12;
  }
  .hairstylist-card-caption {
    padding: 0.85rem;
  }
  .hairstylist-card-caption strong {
    font-size: 1.25rem;
  }
  .hairstylist-card-caption small {
    font-size: 0.66rem;
  }
  .branch-controls {
    margin-top: 1.5rem;
  }
}

/* Gallery editorial di antara cabang dan layanan. */
.site-gallery {
  padding: 3rem 1.25rem 4.5rem;
  background: #090909;
  color: var(--color-white);
}
.site-gallery-inner {
  width: 100%;
  max-width: var(--content-width);
  margin-inline: auto;
}
.site-gallery-title {
  margin: 0 0 1.5rem;
  font-family: Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
  font-size: clamp(4rem, 17vw, 10rem);
  font-weight: 400;
  line-height: 0.82;
  letter-spacing: -0.05em;
}
.site-gallery-title span {
  color: var(--color-accent);
}
.site-gallery-grid {
  columns: 2;
  column-gap: 0.65rem;
}
.site-gallery-item {
  break-inside: avoid;
  margin: 0 0 0.65rem;
  line-height: 0;
}
.site-gallery-item:last-child {
  column-span: all;
}
.site-gallery-item img {
  display: block;
  width: 100%;
  height: auto;
  filter: grayscale(1);
}
@media (min-width: 760px) {
  .site-gallery {
    padding: 5rem 4vw 6rem;
  }
  .site-gallery-title {
    margin-bottom: 2rem;
    font-size: clamp(6rem, 13vw, 10rem);
  }
  .site-gallery-grid {
    columns: 3;
    column-gap: 1rem;
  }
  .site-gallery-item {
    margin-bottom: 1rem;
  }
}
